# Локальная разработка: база в файле (PGlite) и файлы в папке .data
DATABASE_URL=pglite:./.data/pglite
NEXT_PUBLIC_STORAGE=local
SESSION_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me
# Прод (Vercel): DATABASE_URL=postgres://... (Neon), BLOB_READ_WRITE_TOKEN выдаёт Vercel Blob
# TELEGRAM_BOT_TOKEN можно задать тут или в админке → Настройки
